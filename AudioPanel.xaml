<UserControl x:Class="SrtEditor.AudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SrtEditor">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="10" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,5">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="Открыть аудио…" Click="OpenAudio_Click" FontSize="12" MinHeight="26" Padding="8,2" />
                        <Button Content="Закрыть аудио" Click="Close_Click" FontSize="12" MinHeight="26" Padding="8,2"
                                Margin="6,0,0,0" Visibility="{Binding HasSource, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" TextElement.FontFamily="Consolas"
                                TextElement.FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Grid>
                            <TextBlock x:Name="PositionReadout" Text="{Binding PositionTimeLabel}" Padding="4,2"
                                       Background="Transparent" Foreground="{StaticResource Muted}"
                                       Cursor="IBeam" IsEnabled="{Binding CanSeek}" MouseLeftButtonDown="PositionReadout_MouseLeftButtonDown"
                                       ToolTip="Двойной щелчок для ввода времени" AutomationProperties.Name="Текущее время" />
                            <TextBox x:Name="PositionInput" Width="{Binding ActualWidth, ElementName=PositionReadout}"
                                     Padding="2,1" VerticalContentAlignment="Center" Visibility="Collapsed"
                                     PreviewKeyDown="PositionInput_PreviewKeyDown"
                                     LostKeyboardFocus="PositionInput_LostKeyboardFocus"
                                     AutomationProperties.Name="Перейти к времени" />
                        </Grid>
                        <TextBlock Text=" / " Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DurationTimeLabel}" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" AutomationProperties.Name="Длительность аудио" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding PlayLabel}" Click="Play_Click" IsEnabled="{Binding IsReady}"
                                Style="{StaticResource PrimaryButton}" MinWidth="118" MinHeight="28"
                                Padding="8,3" Margin="0,0,6,0" ToolTip="Пробел запускает звук или возвращает к точке старта при паузе" />
                        <Button Content="Стоп" Click="Stop_Click" IsEnabled="{Binding IsReady}"
                                MinHeight="28" Padding="8,3" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="2" Panel.ZIndex="1" Margin="0,6,0,0" Background="{StaticResource Field}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                        Visibility="{Binding HasSource, Converter={StaticResource VisibleWhenTrue}}"
                        UseLayoutRounding="False" Cursor="Hand" IsEnabled="{Binding CanSeek}"
                        PreviewMouseLeftButtonDown="Scrub_MouseDown" PreviewMouseMove="Scrub_MouseMove"
                        PreviewMouseLeftButtonUp="Scrub_MouseUp" LostMouseCapture="Scrub_LostCapture"
                        PreviewMouseWheel="Waveform_MouseWheel"
                        ToolTip="Щелчок перематывает, колесо меняет масштаб, Shift с колесом прокручивает волну">
                    <Grid Margin="{StaticResource AudioSliderInset}">
                        <local:WaveformView x:Name="WaveDisplay" Waveform="{Binding Waveform}" Progress="{Binding Progress}"
                                            IsHitTestVisible="False" AutomationProperties.Name="Звуковая волна" />
                        <TextBlock Text="{Binding WaveformMessage}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="8,0"
                                   Visibility="{Binding HasWaveformMessage, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </Border>
                <Button Grid.Row="2" Margin="0,6,0,0" Background="{StaticResource Field}"
                        Foreground="{StaticResource Muted}" FontSize="12" MinHeight="0" Padding="8,2"
                        Content="Нажмите, чтобы открыть аудио" Click="OpenAudio_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSource}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Slider x:Name="PositionSlider" Grid.Row="3" Margin="1,0" UseLayoutRounding="False"
                        Style="{StaticResource AudioSlider}" Minimum="0" Maximum="1"
                        FocusVisualStyle="{DynamicResource {x:Static SystemParameters.FocusVisualStyleKey}}"
                        SmallChange="100" LargeChange="1000"
                        IsMoveToPointEnabled="False" IsEnabled="{Binding CanSeek}" ValueChanged="PositionSlider_ValueChanged"
                        PreviewMouseLeftButtonDown="Scrub_MouseDown" PreviewMouseMove="Scrub_MouseMove"
                        PreviewMouseLeftButtonUp="Scrub_MouseUp" LostMouseCapture="Scrub_LostCapture"
                        AutomationProperties.Name="Позиция воспроизведения">
                    <Slider.Resources>
                        <ControlTemplate x:Key="AudioSliderHandle" TargetType="Thumb">
                            <Grid Background="Transparent" />
                        </ControlTemplate>
                    </Slider.Resources>
                </Slider>
                <StackPanel Grid.Row="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    Visibility="{Binding HasSource, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel.Resources>
                                <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="MinHeight" Value="22" />
                                    <Setter Property="MinWidth" Value="26" />
                                    <Setter Property="Padding" Value="4,0" />
                                    <Setter Property="FontSize" Value="12" />
                                </Style>
                            </StackPanel.Resources>
                            <Button x:Name="ZoomOutButton" Content="−" Style="{StaticResource ZoomButton}"
                                    Click="ZoomOut_Click" ToolTip="Уменьшить масштаб" AutomationProperties.Name="Уменьшить масштаб" />
                            <Button x:Name="ZoomResetButton" Content="1×" Style="{StaticResource ZoomButton}" MinWidth="40"
                                    Margin="4,0" Click="ZoomReset_Click" ToolTip="Показать всю запись"
                                    AutomationProperties.Name="Показать всю запись" />
                            <Button x:Name="ZoomInButton" Content="+" Style="{StaticResource ZoomButton}"
                                    Click="ZoomIn_Click" ToolTip="Увеличить масштаб" AutomationProperties.Name="Увеличить масштаб" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBlock Text="Громкость" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Slider Style="{StaticResource AudioSlider}" Width="82" Minimum="0" Maximum="1"
                                    SmallChange="0.05" LargeChange="0.1" Value="{Binding Volume, Mode=TwoWay}"
                                    AutomationProperties.Name="Громкость" />
                        </StackPanel>
                        <ScrollBar x:Name="WaveformScroll" Orientation="Horizontal" Visibility="Collapsed"
                                   VerticalAlignment="Center" Height="18" Margin="10,0,2,0" Scroll="WaveformScroll_Scroll"
                                   ToolTip="Прокрутить увеличенную волну" AutomationProperties.Name="Прокрутка звуковой волны">
                            <ScrollBar.Template>
                                <ControlTemplate TargetType="ScrollBar">
                                    <ControlTemplate.Resources>
                                        <Style x:Key="WaveformScrollPage" TargetType="RepeatButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ControlTemplate.Resources>
                                    <Grid Background="Transparent">
                                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                                Background="{StaticResource Line}" />
                                        <Track x:Name="PART_Track" Orientation="Horizontal">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource WaveformScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource WaveformScrollPage}" Command="ScrollBar.PageRightCommand" />
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb x:Name="ScrollThumb" Background="{StaticResource Muted}" Cursor="SizeWE" MinWidth="18">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Height="8" VerticalAlignment="Center" CornerRadius="4"
                                                                    Background="{TemplateBinding Background}" />
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ScrollBar.Template>
                        </ScrollBar>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" ToolTip="{Binding ErrorDetails}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}" />
                    <TextBlock x:Name="PositionError" Foreground="{StaticResource Error}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" MinHeight="106">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Субтитры при воспроизведении" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />
                    <ScrollViewer x:Name="CaptionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
