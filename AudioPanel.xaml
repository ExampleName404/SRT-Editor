<UserControl x:Class="SrtEditor.AudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SrtEditor"
             Visibility="{Binding HasSource, Converter={StaticResource VisibleWhenTrue}}">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="10" Padding="12,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,5">
                    <Button DockPanel.Dock="Right" Content="Закрыть аудио" Click="Close_Click"
                            FontSize="12" MinHeight="26" Padding="8,2" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel Grid.Row="1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeLabel}" FontFamily="Consolas"
                               Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                               Margin="8,0,0,0" AutomationProperties.Name="Время воспроизведения" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding PlayLabel}" Click="Play_Click" IsEnabled="{Binding IsReady}"
                                Style="{StaticResource PrimaryButton}" MinWidth="118" MinHeight="28"
                                Padding="8,3" Margin="0,0,6,0" />
                        <Button Content="Стоп" Click="Stop_Click" IsEnabled="{Binding IsReady}"
                                MinHeight="28" Padding="8,3" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="2" Height="66" Margin="0,6,0,0" Background="{StaticResource Field}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                    <Grid>
                        <local:WaveformView x:Name="WaveDisplay" Waveform="{Binding Waveform}" Progress="{Binding Progress}"
                                            Cursor="Hand" IsEnabled="{Binding CanSeek}"
                                            PreviewMouseLeftButtonDown="Waveform_MouseDown" PreviewMouseMove="Waveform_MouseMove"
                                            PreviewMouseLeftButtonUp="Waveform_MouseUp" LostMouseCapture="Waveform_LostCapture"
                                            AutomationProperties.Name="Звуковая волна" ToolTip="Нажмите или перетащите для перемотки" />
                        <TextBlock Text="{Binding WaveformMessage}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding HasWaveformMessage, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </Border>
                <Slider x:Name="PositionSlider" Grid.Row="3" Minimum="0" Maximum="{Binding TimelineLength}"
                        Value="{Binding Position, Mode=OneWay}" SmallChange="100" LargeChange="1000"
                        IsMoveToPointEnabled="True" IsEnabled="{Binding CanSeek}"
                        ValueChanged="PositionSlider_ValueChanged"
                        AutomationProperties.Name="Позиция воспроизведения" />
                <DockPanel Grid.Row="4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="Громкость" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="82" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding Volume, Mode=TwoWay}" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="Громкость" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" ToolTip="{Binding ErrorDetails}" TextWrapping="Wrap"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Visibility="{Binding HasStatus, Converter={StaticResource VisibleWhenTrue}}" />
                </DockPanel>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" MinHeight="106">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Субтитры при воспроизведении" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />
                    <ScrollViewer x:Name="CaptionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="104" Padding="6,4">
                        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
