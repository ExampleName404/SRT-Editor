<Window x:Class="SrtEditor.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Распознать речь" Icon="Assets/SrtEditor.ico" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#13171D" Foreground="#ECF0F4"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="AudioName" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,14" />
        <Label Content="Язык аудио" Target="{Binding ElementName=LanguageSelector}" Padding="0,0,0,4" />
        <ComboBox x:Name="LanguageSelector" SelectedIndex="0" Margin="0,0,0,12" AutomationProperties.Name="Язык аудио">
            <ComboBoxItem Content="Русский" Tag="ru" />
            <ComboBoxItem Content="Определить автоматически" Tag="auto" />
        </ComboBox>
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Аудио обрабатывается на этом компьютере. Если модели ещё нет, редактор загрузит её при запуске распознавания (около 142 МиБ)." />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"
                     AutomationProperties.Name="Ход распознавания" />
        <TextBlock x:Name="ErrorMessage" Style="{StaticResource Caption}" Foreground="{StaticResource Error}"
                   TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="StartButton" Content="Распознать" Click="Start_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button x:Name="CancelButton" Content="Закрыть" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
