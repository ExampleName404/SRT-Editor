<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SrtEditor</AssemblyName>
    <ApplicationIcon>Assets\SrtEditor.ico</ApplicationIcon>
    <SrtReleaseSeries>1.0</SrtReleaseSeries>
    <VersionPrefix>$(SrtReleaseSeries).0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SrtEditor.ico" />
    <InternalsVisibleTo Include="SrtEditor.Tests" />
    <EmbeddedResource Include="ThirdPartyNotices.txt" />
    <None Update="ThirdPartyNotices.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>
  <Import Project="Build\SrtBuildVersion.targets" />
</Project>
