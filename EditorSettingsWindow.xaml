<Window x:Class="SrtEditor.EditorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Icon="Assets/SrtEditor.ico" Width="570" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#13171D"
        Foreground="#ECF0F4" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="20">
        <TextBlock Text="Локальная история" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <TextBlock Text="Версии хранятся в папке рядом с редактором." Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBox x:Name="CacheFolder" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                 FontSize="13" AutomationProperties.Name="Папка локальных версий" />
        <TextBlock x:Name="CacheStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Очистить историю…" Click="Clear_Click" Foreground="{StaticResource Error}"
                    Margin="0,0,6,0" />
            <Button Content="Закрыть" IsCancel="True" IsDefault="True" />
        </StackPanel>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0"
                Padding="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="ReleaseVersion" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Hyperlink NavigateUri="https://github.com/ExampleName404" RequestNavigate="GitHub_RequestNavigate"
                                   Foreground="{StaticResource Accent}"
                                   ToolTip="{Binding NavigateUri, RelativeSource={RelativeSource Self}}">GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="Автор @dever" Style="{StaticResource Caption}" />
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
