<Window x:Class="SrtEditor.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Версии файла" Icon="Assets/SrtEditor.ico" Width="800" Height="490" MinWidth="660" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#13171D"
        Foreground="#ECF0F4" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DocumentName" Style="{StaticResource SectionTitle}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="VersionList" DisplayMemberPath="Label" SelectionChanged="VersionList_SelectionChanged"
                     Background="{StaticResource Field}" Foreground="#ECF0F4" BorderBrush="{StaticResource Line}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Локальные версии">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="EmptyHint" Text="Для этого файла пока нет версий."
                       Margin="10,9" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       IsHitTestVisible="False" Visibility="Collapsed" />
            <TextBox x:Name="VersionPreview" Grid.Column="2" IsReadOnly="True" FontFamily="Consolas"
                     FontSize="13" Padding="10" TextWrapping="Wrap" IsUndoEnabled="False"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Содержимое версии" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CompareButton" Content="Сравнить с этой версией" Click="Compare_Click"
                    IsEnabled="False" Margin="0,0,6,0" />
            <Button x:Name="RestoreButton" Content="Восстановить в редакторе" Click="Restore_Click"
                    IsEnabled="False" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" />
            <Button Content="Закрыть" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
