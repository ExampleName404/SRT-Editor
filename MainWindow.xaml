<Window x:Class="SrtEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1240" Height="790" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#13171D" Foreground="#ECF0F4"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1B2029" />
        <SolidColorBrush x:Key="Field" Color="#151A21" />
        <SolidColorBrush x:Key="Line" Color="#323A47" />
        <SolidColorBrush x:Key="Muted" Color="#ABB4C1" />
        <SolidColorBrush x:Key="Accent" Color="#9FEBCE" />
        <SolidColorBrush x:Key="Error" Color="#FFADAB" />
        <SolidColorBrush x:Key="Warning" Color="#F5CA84" />
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECF0F4" />
            <Setter Property="Background" Value="#262D39" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A4B0C1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#DDFCEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#142B23" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#ECF0F4" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#588475" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimeInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <EventSetter Event="LostKeyboardFocus" Handler="Field_LostKeyboardFocus" />
            <EventSetter Event="GotKeyboardFocus" Handler="TimeInput_GotKeyboardFocus" />
        </Style>
        <Style x:Key="CueContainer" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Number, StringFormat='Субтитр {0}'}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                            <Border x:Name="Before" Height="2" VerticalAlignment="Top" Margin="0,-3,0,0"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Border x:Name="After" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Before">
                                <Setter TargetName="Before" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="After">
                                <Setter TargetName="After" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewGotKeyboardFocus" Handler="Cue_PreviewGotKeyboardFocus" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="SRT Editor" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FileLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Новый" Click="New_Click" ToolTip="Ctrl+N" Margin="0,0,6,0" />
                <Button Content="Открыть…" Click="Open_Click" ToolTip="Ctrl+O" Margin="0,0,6,0" />
                <Button Content="Сохранить" Click="Save_Click" ToolTip="Ctrl+S" Margin="0,0,6,0" />
                <Button Content="Сохранить как…" Click="SaveAs_Click" ToolTip="Ctrl+Shift+S" Margin="0,0,14,0" />
                <Button Content="Отменить" Click="Undo_Click" IsEnabled="{Binding CanUndo}"
                        ToolTip="Ctrl+Z" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" MinWidth="545" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12,14,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BlockCount}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="Субтитры" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,9">
                        <Button Content="Добавить блок" Click="Add_Click" Margin="0,0,6,4"
                                ToolTip="Вставить после выбранного блока (Ctrl+Enter)" />
                        <Button Content="Удалить" Click="Delete_Click" IsEnabled="{Binding HasSelection}"
                                Margin="0,0,6,4" />
                        <Button Content="Заполнить концы по следующим началам" Click="FillEnds_Click"
                                IsEnabled="{Binding HasMultipleCues}" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,4" />
                    </WrapPanel>
                    <ListBox x:Name="CueList" Grid.Row="2" ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CueContainer}" Background="Transparent"
                             BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel" AllowDrop="True"
                             PreviewDragOver="CueList_DragOver" PreviewDrop="CueList_Drop"
                             PreviewDragLeave="CueList_DragLeave">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="7" Padding="10,8,10,8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#202631" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#293541" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Number}" TextAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Muted}" />
                                            <Border Padding="1,5" Background="Transparent" Cursor="SizeAll"
                                                    ToolTip="Перетащить блок" PreviewMouseLeftButtonDown="Grip_MouseDown"
                                                    PreviewMouseMove="Grip_MouseMove" PreviewMouseLeftButtonUp="Grip_MouseUp">
                                                <TextBlock Text="⠿" TextAlignment="Center" FontSize="17"
                                                           Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <WrapPanel Margin="0,0,0,6">
                                                <StackPanel Width="126" Margin="0,0,8,4">
                                                    <TextBlock Text="Начало" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="StartInput" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TimeInput}" AutomationProperties.Name="Начало"
                                                             ToolTip="Пример: 5.250 или 00:00:05,250. Enter — перейти к следующему началу." />
                                                </StackPanel>
                                                <StackPanel Width="126" Margin="0,0,8,4">
                                                    <TextBlock Text="Конец" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                                    <TextBox x:Name="EndInput" Text="{Binding End, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource TimeInput}" AutomationProperties.Name="Конец"
                                                             ToolTip="Пример: 5.250 или 00:00:05,250" />
                                                </StackPanel>
                                                <Button Content="Взять конец предыдущего" Click="CopyPreviousEnd_Click"
                                                        IsEnabled="{Binding HasPrevious}" VerticalAlignment="Bottom"
                                                        Margin="0,0,0,4" Padding="8,5" FontSize="12" IsTabStop="False"
                                                        ToolTip="Подставить конец предыдущего блока в поле «Начало»" />
                                            </WrapPanel>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="135"
                                                     VerticalScrollBarVisibility="Auto" IsUndoEnabled="False"
                                                     AutomationProperties.Name="Текст субтитра" LostKeyboardFocus="Field_LostKeyboardFocus" />
                                            <TextBlock Text="{Binding IssueText}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Откройте SRT или добавьте первый блок."
                               Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12,14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Предпросмотр SRT" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="13" Padding="10" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" IsUndoEnabled="False"
                             AutomationProperties.Name="Предпросмотр SRT" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0" MinHeight="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Validation}" Foreground="{StaticResource Warning}"
                       FontSize="12" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>
